<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_view_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.contract.retention</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <button name="button_draft" position="after">
                <button name="action_release_retention" string="Release Retention" type="object"
                        groups="account.group_account_user"
                        invisible="state != 'posted' or move_type != 'out_invoice' or not retention_held"/>
            </button>

            <xpath expr="//field[@name='invoice_payments_widget']" position="before">
                <field name="retention_amount" string="Less: Retention"
                       invisible="move_type not in ('out_invoice', 'out_refund') or not retention_amount"/>
                <field name="advance_recovery_amount" string="Less: Advance Recovery"
                       invisible="move_type not in ('out_invoice', 'out_refund') or not advance_recovery_amount"/>
                <field name="amount_payable_now" class="oe_subtotal_footer_separator"
                       invisible="move_type not in ('out_invoice', 'out_refund') or not (retention_amount or advance_recovery_amount)"/>
            </xpath>
            <xpath expr="//group[hasclass('oe_subtotal_footer')]/field[@name='amount_residual']" position="attributes">
                <attribute name="invisible">state == 'draft' and (retention_amount or advance_recovery_amount)</attribute>
            </xpath>

            <page id="other_tab" position="before">
                <page id="contract_retention_tab" name="contract_retention" string="Retention &amp; Advance"
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <group string="Retention">
                            <field name="contract_order_id" invisible="not contract_order_id"/>
                            <field name="retention_percent" readonly="state != 'draft' or move_type == 'out_refund'"/>
                            <field name="retention_due_date" readonly="state != 'draft' or move_type == 'out_refund'"
                                   required="retention_percent and state == 'draft'"/>
                            <field name="retention_amount"/>
                            <field name="retention_held" invisible="state != 'posted'"/>
                        </group>
                        <group string="Advance Recovery">
                            <field name="advance_payment_id" options="{'no_create': True}"
                                   readonly="state != 'draft' or move_type == 'out_refund'"/>
                            <field name="advance_available" invisible="not advance_payment_id or state != 'draft'"/>
                            <field name="advance_recovery_method" widget="radio" options="{'horizontal': true}"
                                   invisible="not advance_payment_id or move_type == 'out_refund'"
                                   readonly="state != 'draft'"/>
                            <field name="advance_recovery_percent"
                                   invisible="not advance_payment_id or advance_recovery_method != 'percent' or move_type == 'out_refund'"
                                   readonly="state != 'draft'"/>
                            <field name="advance_recovery_fixed"
                                   invisible="not advance_payment_id or advance_recovery_method != 'fixed' or move_type == 'out_refund'"
                                   readonly="state != 'draft'"/>
                            <field name="advance_recovery_amount" invisible="not advance_payment_id"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <record id="account_move_out_invoice_view_list" model="ir.ui.view">
        <field name="name">account.out.invoice.list.inherit.contract.retention</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="amount_total_in_currency_signed" position="after">
                <field name="retention_amount" optional="hide" sum="Total"/>
                <field name="advance_recovery_amount" optional="hide" sum="Total"/>
            </field>
        </field>
    </record>
</odoo>
