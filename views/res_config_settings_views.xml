<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.contract.retention</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="invoicing_settings" position="after">
                <block title="Contract Retention" id="contract_retention_settings">
                    <setting id="retention_account" string="Retention" company_dependent="1"
                             help="Retention held on customer invoices until the project is handed over.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="retention_account_id" string="Receivable Account" class="col-lg-4 o_light_label"/>
                                <field name="retention_account_id" options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="retention_percent" string="Default %" class="col-lg-4 o_light_label"/>
                                <field name="retention_percent"/>
                            </div>
                            <div class="row">
                                <label for="retention_journal_id" string="Release Journal" class="col-lg-4 o_light_label"/>
                                <field name="retention_journal_id" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
