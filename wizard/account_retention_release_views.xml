<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_retention_release_view_form" model="ir.ui.view">
        <field name="name">account.retention.release.form</field>
        <field name="model">account.retention.release</field>
        <field name="arch" type="xml">
            <form string="Release Retention">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        <field name="company_id" invisible="1"/>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="order_id" options="{'no_create': True}"/>
                        <field name="currency_id" groups="base.group_multi_currency" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="amount_held"/>
                        <field name="amount"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="move_line_id" column_invisible="True" force_save="1"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="move_id"/>
                        <field name="order_id" optional="show"/>
                        <field name="date_maturity"/>
                        <field name="amount_held" sum="Total"/>
                        <field name="release_amount" sum="Total"/>
                    </list>
                </field>
                <footer>
                    <button name="action_release" string="Release" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="account_retention_release_action" model="ir.actions.act_window">
        <field name="name">Release Retention</field>
        <field name="res_model">account.retention.release</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
