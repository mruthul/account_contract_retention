<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="contract_retention_report" model="account.report">
        <field name="name">Retention and Advances</field>
        <field name="filter_date_range" eval="False"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_show_draft" eval="False"/>
        <field name="filter_unfold_all" eval="False"/>
        <field name="filter_multi_company">selector</field>
        <field name="default_opening_date_filter">today</field>
        <field name="search_bar" eval="True"/>
        <field name="custom_handler_model_id" ref="model_account_contract_retention_report_handler"/>
        <field name="column_ids">
            <record id="contract_retention_report_invoiced" model="account.report.column">
                <field name="name">Total Invoiced</field>
                <field name="expression_label">invoiced</field>
            </record>
            <record id="contract_retention_report_retention_held" model="account.report.column">
                <field name="name">Retention Held</field>
                <field name="expression_label">retention_held</field>
            </record>
            <record id="contract_retention_report_retention_released" model="account.report.column">
                <field name="name">Retention Released</field>
                <field name="expression_label">retention_released</field>
            </record>
            <record id="contract_retention_report_retention_balance" model="account.report.column">
                <field name="name">Retention Balance</field>
                <field name="expression_label">retention_balance</field>
            </record>
            <record id="contract_retention_report_advance_received" model="account.report.column">
                <field name="name">Advance Received</field>
                <field name="expression_label">advance_received</field>
            </record>
            <record id="contract_retention_report_advance_recovered" model="account.report.column">
                <field name="name">Advance Recovered</field>
                <field name="expression_label">advance_recovered</field>
            </record>
            <record id="contract_retention_report_advance_balance" model="account.report.column">
                <field name="name">Advance Balance</field>
                <field name="expression_label">advance_balance</field>
            </record>
        </field>
    </record>

    <record id="contract_retention_report_action" model="ir.actions.client">
        <field name="name">Retention and Advances</field>
        <field name="tag">account_report</field>
        <field name="path">retention-advances</field>
        <field name="context" eval="{'report_id': ref('contract_retention_report')}"/>
    </record>
</odoo>
